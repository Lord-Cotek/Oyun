{
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/morning",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily?sweep=2",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/weekly?sweep=2",
      "schedule": "30 13 * * 1"
    },
    {
      "path": "/api/cron/health",
      "schedule": "*/15 * * * *"
    }
  ]
}
