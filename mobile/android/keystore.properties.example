# Copy to android/keystore.properties (git-ignored) for LOCAL release builds in
# Android Studio. On Codemagic this file is written automatically from the
# signing identity you configure in the UI — you do NOT commit it.
storeFile=/absolute/path/to/oyun-upload.jks
storePassword=your-store-password
keyAlias=oyun-upload
keyPassword=your-key-password
