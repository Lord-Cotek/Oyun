generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth (magic-link) ────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  notifyByEmail Boolean   @default(true)
  weeklyDigest  Boolean   @default(true)

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  ownedJourneys Journey[]  @relation("JourneyOwner")
  checkIns    CheckIn[]
  letters     Letter[]
  nudges      Nudge[]
  encouragements Encouragement[]
  supportDays SupportDay[]
  notifications Notification[]
  prayerRequests PrayerRequest[]
  prayerPrays    PrayerPray[]
  pushSubscriptions PushSubscription[]
  remembrances   Remembrance[]

  createdAt DateTime @default(now())
}

/// A word written in memory of a child who was lost — from the mother or,
/// just as importantly, from the circle who grieves with her.
model Remembrance {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([journeyId, createdAt])
}

/// A specific prayer request the circle can pray against and mark answered.
model PrayerRequest {
  id         String       @id @default(cuid())
  journeyId  String
  journey    Journey      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  answeredAt DateTime?
  createdAt  DateTime     @default(now())
  prayers    PrayerPray[]

  @@index([journeyId, createdAt])
}

/// One row per person who has prayed for a request.
model PrayerPray {
  id        String        @id @default(cuid())
  requestId String
  request   PrayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([requestId, userId])
}

/// A Web Push subscription for a user's device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// In-app notification for a user (bell menu). Some also trigger an email.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Single-use, time-limited token backing the "forgot password" flow.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ── Oyun domain ──────────────────────────────────────────────────────────
enum Role {
  MOTHER
  PARTNER
  ACCOUNTABILITY
}

enum JourneyStatus {
  ACTIVE
  LOSS
}

enum Mood {
  HEAVY // 1
  LOW // 2
  STEADY // 3
  BRIGHT // 4
  RADIANT // 5
}

enum MilestoneKind {
  FIRST_KICK
  ULTRASOUND
  HEARTBEAT
  BIRTH
  FIRST_SMILE
  FIRST_WORD
  FIRST_STEPS
  CUSTOM
}

/// The mother owns one active Journey.
model Journey {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("JourneyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  babyName  String?
  babyCount Int      @default(1)
  status    JourneyStatus @default(ACTIVE)
  lossAt    DateTime?
  createdAt DateTime @default(now())

  memberships    Membership[]
  invites        Invite[]
  checkIns       CheckIn[]
  letters        Letter[]
  milestones     Milestone[]
  nudges         Nudge[]
  encouragements Encouragement[]
  supportDays    SupportDay[]
  children       Child[]
  prayerRequests PrayerRequest[]
  remembrances   Remembrance[]
  worshipDays    WorshipDay[]
}

/// One row per day the household kept family worship — a shared streak.
model WorshipDay {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([journeyId, day])
  @@index([journeyId])
}

/// A child profile (0-2 years). One per baby — supports twins and multiples.
model Child {
  id         String      @id @default(cuid())
  journeyId  String
  journey    Journey     @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  name       String
  birthDate  DateTime?
  sex        String? // "boy" | "girl" | null
  photoUrl   String?
  note       String?
  createdAt  DateTime    @default(now())
  milestones Milestone[]

  @@index([journeyId])
}

/// Links a User to a Journey with a role.
model Membership {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([journeyId, userId])
}

/// Email invite flow for the partner / accountability view.
model Invite {
  id         String    @id @default(cuid())
  journeyId  String
  journey    Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  email      String
  role       Role
  token      String    @unique @default(cuid())
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([journeyId])
}

/// Mood / heart check-ins.
model CheckIn {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Mood
  note      String?
  createdAt DateTime @default(now())

  @@index([journeyId, createdAt])
}

/// Letters to the baby / to each other.
model Letter {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  toBaby    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([journeyId, createdAt])
}

/// Capturing the firsts.
model Milestone {
  id         String        @id @default(cuid())
  journeyId  String
  journey    Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  childId    String?
  child      Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)
  kind       MilestoneKind
  title      String? // custom label, especially when kind is CUSTOM
  note       String?
  occurredAt DateTime
  photoUrls  String[]      @default([])
  createdAt  DateTime      @default(now())

  @@index([journeyId, occurredAt])
}

/// Gentle reminders — "check in on her today" / appointment reminders.
model Nudge {
  id        String    @id @default(cuid())
  journeyId String
  journey   Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([journeyId, dueAt])
}

/// A short word of encouragement or Scripture from one member to another —
/// the two-way connective tissue between the mother and her supporter.
model Encouragement {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  verseRef  String?
  createdAt DateTime @default(now())

  @@index([journeyId, createdAt])
}

/// One row per supporter per day: did they pray for her / reach out today?
/// Powers the partner's faithfulness streak.
model SupportDay {
  id         String   @id @default(cuid())
  journeyId  String
  journey    Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        DateTime @db.Date
  prayed     Boolean  @default(false)
  reachedOut Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([journeyId, userId, day])
  @@index([journeyId, userId])
}
