generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth (magic-link) ────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  ownedJourneys Journey[]  @relation("JourneyOwner")
  checkIns    CheckIn[]
  letters     Letter[]
  nudges      Nudge[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Oyun domain ──────────────────────────────────────────────────────────
enum Role {
  MOTHER
  PARTNER
  ACCOUNTABILITY
}

enum Mood {
  HEAVY // 1
  LOW // 2
  STEADY // 3
  BRIGHT // 4
  RADIANT // 5
}

enum MilestoneKind {
  FIRST_KICK
  ULTRASOUND
  HEARTBEAT
  BIRTH
  FIRST_SMILE
  FIRST_WORD
  FIRST_STEPS
  CUSTOM
}

/// The mother owns one active Journey.
model Journey {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("JourneyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  babyName  String?
  createdAt DateTime @default(now())

  memberships Membership[]
  invites     Invite[]
  checkIns    CheckIn[]
  letters     Letter[]
  milestones  Milestone[]
  nudges      Nudge[]
}

/// Links a User to a Journey with a role.
model Membership {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([journeyId, userId])
}

/// Email invite flow for the partner / accountability view.
model Invite {
  id         String    @id @default(cuid())
  journeyId  String
  journey    Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  email      String
  role       Role
  token      String    @unique @default(cuid())
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([journeyId])
}

/// Mood / heart check-ins.
model CheckIn {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Mood
  note      String?
  createdAt DateTime @default(now())

  @@index([journeyId, createdAt])
}

/// Letters to the baby / to each other.
model Letter {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  toBaby    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([journeyId, createdAt])
}

/// Capturing the firsts.
model Milestone {
  id         String        @id @default(cuid())
  journeyId  String
  journey    Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  kind       MilestoneKind
  note       String?
  occurredAt DateTime
  photoUrl   String?
  createdAt  DateTime      @default(now())

  @@index([journeyId, occurredAt])
}

/// Gentle reminders — "check in on her today" / appointment reminders.
model Nudge {
  id        String    @id @default(cuid())
  journeyId String
  journey   Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  dueAt     DateTime
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([journeyId, dueAt])
}
