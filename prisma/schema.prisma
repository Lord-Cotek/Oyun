generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth (magic-link) ────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  notifyByEmail Boolean   @default(true)
  weeklyDigest  Boolean   @default(true)

  /// What may interrupt this person — see lib/notify-prefs.ts. Each governs a
  /// group a family recognises rather than a notification type, and each
  /// defaults to true so nobody who was already being told stops being told.
  /// Switching one off silences the push and the email; the notification is
  /// still written down and still appears in the bell.
  notifyCircle Boolean @default(true)
  notifyHer    Boolean @default(true)
  notifyDates  Boolean @default(true)
  notifyDiary  Boolean @default(true)
  notifyHouse  Boolean @default(true)

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  ownedJourneys     Journey[]             @relation("JourneyOwner")
  checkIns          CheckIn[]
  letters           Letter[]
  nudges            Nudge[]
  encouragements    Encouragement[]
  supportDays       SupportDay[]
  notifications     Notification[]
  prayerRequests    PrayerRequest[]
  appointments      Appointment[]
  prayerPrays       PrayerPray[]
  pushSubscriptions PushSubscription[]
  nativePushTokens  NativePushToken[]
  remembrances      Remembrance[]
  reactions         Reaction[]
  readingNotes      ReadingNote[]
  posts             Post[]
  postComments      PostComment[]
  postReactions     PostReaction[]
  commentReactions  PostCommentReaction[]

  createdAt     DateTime       @default(now())
  journeyEvents JourneyEvent[] @relation("JourneyEventCreator")
  letterReplies LetterReply[]
  postShares    PostShare[]
}

/// A small emoji reaction on an encouragement or a check-in.
model Reaction {
  id         String   @id @default(cuid())
  targetType String // "ENCOURAGEMENT" | "CHECKIN"
  targetId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji      String
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, userId, emoji])
  @@index([targetType, targetId])
}

/// A word written in memory of a child who was lost — from the mother or,
/// just as importantly, from the circle who grieves with her.
model Remembrance {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([journeyId, createdAt])
}

/// A specific prayer request the circle can pray against and mark answered.
model PrayerRequest {
  id         String       @id @default(cuid())
  journeyId  String
  journey    Journey      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  answeredAt DateTime?
  createdAt  DateTime     @default(now())
  prayers    PrayerPray[]

  @@index([journeyId, createdAt])
}

/// One row per person who has prayed for a request.
model PrayerPray {
  id        String        @id @default(cuid())
  requestId String
  request   PrayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([requestId, userId])
}

/// A Web Push subscription for a user's device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// A device token for native push (FCM on Android; APNs-via-Firebase on iOS),
// used by the installed Capacitor apps. Web push uses PushSubscription instead.
model NativePushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("unknown") // "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// In-app notification for a user (bell menu). Some also trigger an email.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Single-use, time-limited token backing the "forgot password" flow.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ── Oyun domain ──────────────────────────────────────────────────────────
enum Role {
  MOTHER
  PARTNER
  ACCOUNTABILITY
  FAMILY // a close relative — grandparent, sister, cousin
  FRIEND // a close friend walking with them
}

enum JourneyStatus {
  ACTIVE
  LOSS
}

enum Mood {
  HEAVY // 1
  LOW // 2
  STEADY // 3
  BRIGHT // 4
  RADIANT // 5
}

enum MilestoneKind {
  FIRST_KICK
  ULTRASOUND
  HEARTBEAT
  BIRTH
  FIRST_SMILE
  FIRST_WORD
  FIRST_STEPS
  CUSTOM
}

/// The mother owns one active Journey.
model Journey {
  id        String        @id @default(cuid())
  ownerId   String
  owner     User          @relation("JourneyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  dueDate   DateTime
  babyName  String?
  babyCount Int           @default(1)
  status    JourneyStatus @default(ACTIVE)
  lossAt    DateTime?
  createdAt DateTime      @default(now())
  /// The photograph at the top of the home screen.
  ///
  /// Null means "whatever was shared most recently", which is what this did
  /// before anyone could choose — a sensible default and a poor permanent
  /// answer, because the first thing you see every day should not change
  /// because somebody posted a screenshot. Setting this pins one picture;
  /// clearing it goes back to following the feed.
  coverUrl  String?

  // Scripture Journey — a chosen reading plan that advances by completion.
  readingPlanId    String?
  readingProgress  Int       @default(0)
  readingUpdatedAt DateTime?

  memberships    Membership[]
  registry       Registry?
  invites        Invite[]
  checkIns       CheckIn[]
  letters        Letter[]
  milestones     Milestone[]
  nudges         Nudge[]
  encouragements Encouragement[]
  supportDays    SupportDay[]
  children       Child[]
  prayerRequests PrayerRequest[]
  remembrances   Remembrance[]
  worshipDays    WorshipDay[]
  readingNotes   ReadingNote[]
  posts          Post[]
  appointments   Appointment[]
  journeyEvents  JourneyEvent[]
  postShares     PostShare[]
  shareHellos    ShareHello[]
  joinRequests   JoinRequest[]
}

/// The family feed — an update, a praise, a prayer, or a milestone that the
/// circle (mother, partner, and supporters) shares and carries together.
model Post {
  id         String    @id @default(cuid())
  journeyId  String
  journey    Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind       String    @default("UPDATE") // UPDATE | PRAISE | PRAYER | MILESTONE
  body       String
  imageUrl   String? // legacy single image; new posts use mediaUrls
  mediaUrls  String[]  @default([]) // images and videos, in order
  /// Kept to the family: the mother, the one beside her, and the relatives on
  /// this journey. An accountability partner or a friend in the circle never
  /// sees it, anywhere — not in the diary, not in search, not in the export,
  /// and not as a notification.
  ///
  /// False by default, which is exactly what every post written before this
  /// existed was. Nothing a family has already shared changes audience
  /// underneath them. Who counts as family is decided in one place,
  /// lib/post-visibility.ts, and every query that reads a post asks it.
  familyOnly Boolean   @default(false)
  createdAt  DateTime  @default(now())
  editedAt   DateTime?

  comments  PostComment[]
  reactions PostReaction[]
  shares    PostShare[]

  hellos ShareHello[]

  @@index([journeyId, createdAt])
}

/// One post, on a link anybody can open.
///
/// The third and last audience a post can have — see lib/post-share.ts for
/// what that means and why it is fenced the way it is. A row here is the ONLY
/// thing that makes a post reachable without signing in; no row, no link.
model PostShare {
  id          String    @id @default(cuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Denormalised from the post so every link a family has made can be listed in
  /// one query without reading the posts themselves.
  ///
  /// It does NOT outlive the post: `onDelete: Cascade` above means deleting a
  /// post takes its links with it, which is the behaviour anybody would
  /// expect and the only safe one — a live address pointing at something the
  /// family deleted is the worst possible outcome.
  journeyId   String
  journey     Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  /// The address itself. Unguessable, and unique so a collision is a database
  /// error rather than two families quietly sharing one page.
  token       String    @unique
  /// Null means "until I close it" — a deliberate choice, never the default.
  expiresAt   DateTime?
  /// Set the moment somebody takes it back. The row stays, so the family can
  /// still see that they once shared it and what happened to it.
  revokedAt   DateTime?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())

  hellos       ShareHello[]
  joinRequests JoinRequest[]

  @@index([journeyId, createdAt])
  @@index([postId])
}

/// A word from somebody outside, on a shared post.
///
/// ── Who ever reads one ───────────────────────────────────────────────────
/// The family, and the person who wrote it. Nobody else — not other guests
/// holding the same link, not the circle inside the app. It is a message TO
/// the family, not a comment thread, and that is the whole reason this is
/// safe to offer: nothing a stranger writes here is ever shown to another
/// stranger, so a forwarded link cannot become a place where people who do
/// not know this family talk to each other over a picture of their child.
model ShareHello {
  id         String    @id @default(cuid())
  shareId    String
  share      PostShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  /// Denormalised so a hello outlives the link that carried it. Somebody's
  /// kind word in month four should still be there in year ten, long after
  /// the link it arrived through was closed.
  postId     String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  journeyId  String
  journey    Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  name       String
  body       String
  /// The cookie in the guest's browser. One hello per person per link — which
  /// is both the rate limit and the reason somebody can come back and change
  /// what they said.
  guestToken String
  createdAt  DateTime  @default(now())
  /// The family took it down. Kept rather than deleted so the same person
  /// cannot simply post it again into an empty slot.
  hiddenAt   DateTime?

  @@unique([shareId, guestToken])
  @@index([journeyId, createdAt])
  @@index([postId, createdAt])
}

/// Somebody outside asking to be let in.
///
/// ── Why this is a request and not a membership ───────────────────────────
/// A link can be forwarded. If opening a link could put somebody in a
/// family's circle, then the link IS the circle, and one WhatsApp group would
/// put a stranger inside a pregnancy. So nothing here grants anything. The
/// household reads it, decides, and CHOOSES THE ROLE ITSELF — what the person
/// claims to be is written down as a hint and is never acted on by the app.
model JoinRequest {
  id         String     @id @default(cuid())
  journeyId  String
  journey    Journey    @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  /// Which link brought them. SetNull rather than Cascade: closing a link must
  /// never quietly delete somebody's request to be part of the family.
  shareId    String?
  share      PostShare? @relation(fields: [shareId], references: [id], onDelete: SetNull)
  name       String
  /// What they say they are. A hint on a card, never a grant.
  relation   String
  email      String
  note       String?
  guestToken String
  /// PENDING | INVITED | DECLINED
  status     String     @default("PENDING")
  decidedAt  DateTime?
  createdAt  DateTime   @default(now())

  @@index([journeyId, status, createdAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  reactions PostCommentReaction[]

  @@index([postId, createdAt])
}

/// A reaction to somebody's REPLY, not to the post itself.
///
/// Its own table rather than a nullable column on PostReaction: that one is
/// unique on (postId, userId, kind) and making postId optional would weaken a
/// constraint that is doing real work. Same shape, same `kind` strings from
/// lib/feed.ts, so a reply answers the way a post does.
model PostCommentReaction {
  id        String      @id @default(cuid())
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime    @default(now())

  @@unique([commentId, userId, kind])
  @@index([commentId])
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@unique([postId, userId, kind])
  @@index([postId])
}

/// A reflection or note on a Scripture reading. Shared with the journey by
/// default; the author may keep it private (visible only to them).
model ReadingNote {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bookSlug  String
  chapter   Int
  body      String
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId, bookSlug, chapter])
  @@index([authorId])
}

/// One row per day the household kept family worship — a shared streak.
model WorshipDay {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([journeyId, day])
  @@index([journeyId])
}

/// A child profile (0-2 years). One per baby — supports twins and multiples.
model Child {
  id         String      @id @default(cuid())
  journeyId  String
  journey    Journey     @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  name       String
  birthDate  DateTime?
  sex        String? // "boy" | "girl" | null
  photoUrl   String?
  note       String?
  createdAt  DateTime    @default(now())
  milestones Milestone[]
  letters    Letter[]

  @@index([journeyId])
}

/// Links a User to a Journey with a role.
model Membership {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  // A personal Scripture Journey — reading on your own, alongside (or instead
  // of) the shared journey plan.
  readingPlanId    String?
  readingProgress  Int       @default(0)
  readingUpdatedAt DateTime?

  @@unique([journeyId, userId])
}

/// Email invite flow for the partner / accountability view.
model Invite {
  id         String    @id @default(cuid())
  journeyId  String
  journey    Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  email      String
  role       Role
  token      String    @unique @default(cuid())
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([journeyId])
}

/// Mood / heart check-ins.
model CheckIn {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Mood
  note      String?
  createdAt DateTime @default(now())

  @@index([journeyId, createdAt])
}

/// Letters to the baby / to each other.
model Letter {
  id        String        @id @default(cuid())
  journeyId String
  journey   Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  toBaby    Boolean       @default(true)
  /// Which of them it is written to, once there is more than one of them.
  ///
  /// Null means all of them, which is what a letter written during the
  /// pregnancy is and what every letter written before this column existed
  /// stays. A family with one baby never sees this: there is nothing to
  /// choose between, so the picker does not appear and the column stays null.
  ///
  /// SetNull rather than Cascade on purpose. If a child row is ever removed,
  /// the letters written to them must not go with it — they are the most
  /// irreplaceable thing in this app, and a letter that quietly becomes a
  /// letter to all of them is a far better failure than a letter that is gone.
  childId   String?
  child     Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  replies   LetterReply[]

  @@index([journeyId, createdAt])
}

/// A written reply to a letter.
///
/// Letters used to take emoji only, and an emoji is the right weight for
/// "I saw this" and the wrong one for answering it. A letter between two
/// people is a conversation; it was being given a doorbell and no door.
///
/// Who may write one is not decided here — see lib/letter-access.ts. The rule
/// is exactly the rule for reacting, and both call the same function, because
/// two copies of a permission rule is one rule and one bug waiting.
model LetterReply {
  id        String   @id @default(cuid())
  letterId  String
  letter    Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([letterId, createdAt])
}

/// ── The registry ─────────────────────────────────────────────────────────
///
/// One list of what a family actually needs, made of links to wherever those
/// things are sold, and shared as a single address anybody can open.
///
/// Why this is in a family app at all: a registry is a pregnancy-shaped need.
/// It appears around the sixth month, peaks at the shower, and is finished a
/// few weeks after the birth — one of the very few features here that ends by
/// itself. And the people it is for are already here. Every other registry
/// makes a mother assemble an audience from nothing; this one already knows
/// who the grandmothers are.
///
/// Why links rather than a shop: there is no single store this family buys
/// from. Amazon, Noon, Mumzworld, a shop in Lekki, a cousin bringing a thing
/// from London. A registry tied to one retailer is useless to them, so this
/// holds a link to anywhere and does not care where.
///
/// ── What it deliberately does not do ─────────────────────────────────────
/// No money passes through this app. Not a payment, not a cash gift, not a
/// contribution to a fund. The moment it did, this would stop being a family
/// app and become a regulated payments product, and that is a decision to
/// take on purpose rather than to arrive at by accident.
///
/// It also does not claim to know what anybody actually bought. No shop tells
/// you that, and pretending otherwise would be a lie told to a mother about
/// whether her baby has a cot. What it knows is what somebody SAID they were
/// getting — see RegistryClaim.
model Registry {
  id         String    @id @default(cuid())
  journeyId  String    @unique
  journey    Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  /// The unguessable half of the public address. From node:crypto and long —
  /// see lib/registry-db.ts, and NOT lib/rand.ts, which says of itself that
  /// it is not security-bearing.
  slug       String    @unique
  /// What the page is called: "For Baby Adeyemi". Hers to type.
  title      String
  /// How it signs itself to a guest — "Amara and Chidi", "The Adeyemis".
  /// Typed, never taken from an account, so she chooses what a stranger is
  /// told about who she is.
  hostName   String
  /// A word to whoever opens it.
  message    String?
  /// Whether she is shown who has taken what.
  ///
  /// Off is the surprise: she sees that a thing is spoken for and not by
  /// whom, until she closes the registry — at which point the whole list
  /// appears, because by then she is writing thank-you notes and needs it.
  showClaims Boolean   @default(true)
  /// ── How somebody sends money, when she wants that offered ────────────
  ///
  /// Her own details, typed by her: a bank account, a mobile-money number, a
  /// handle on whatever people use where she lives. Money does NOT pass
  /// through this app — a guest reads these and sends directly, exactly as
  /// they would if she had texted them. Oyun never sees a card, never holds a
  /// penny and takes no cut, which is what keeps this a family app rather
  /// than a regulated payments product.
  ///
  /// Null until she fills them in, and no cash card can be offered before
  /// that.
  ///
  /// These are the most sensitive thing on a public page, so they are NOT
  /// rendered into it. A guest taps to ask for them and they are fetched
  /// then — which keeps them out of the first paint, out of a screenshot of
  /// the page, and out of anything a link-preview crawler reads. Anybody
  /// holding the link can still tap. That is said plainly where she types
  /// them: it is friction and a smaller blast radius, not a wall.
  payLabel   String?
  payDetails String?
  payNote    String?
  /// Stopped taking claims. The page still reads; it becomes a record.
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items RegistryItem[]
}

/// One thing on the list.
///
/// `kind` is the whole reason this is more than a list of shopping links:
///
///   THING — a thing in a shop, with a link to it.
///   HELP  — not a thing at all. A week of meals, three evenings of cooking,
///           a lift to the 34-week appointment, somebody to hold the baby
///           while she sleeps. Every registry in the world does products;
///           this is the half of what a new mother needs that none of them
///           will let anybody give her.
///   CASH  — money towards something, sent directly to her by whatever means
///           she has typed onto the registry. The app is not in the middle of
///           it: this is a card that says "the cot fund" and, on request, how
///           to send. What we know afterwards is that somebody SAID they had
///           sent something — a note for a thank-you, never a receipt.
///   LIST  — a whole list kept somewhere else, an Amazon wishlist most often.
///           One card, one link, and no pretence that we know what is on it:
///           scraping somebody's wishlist is fragile and breaks the week the
///           shop changes its markup. So it points, and the shop keeps its
///           own record of what has been bought from it.
model RegistryItem {
  id         String   @id @default(cuid())
  registryId String
  registry   Registry @relation(fields: [registryId], references: [id], onDelete: Cascade)
  kind       String   @default("THING")
  title      String
  note       String?
  /// Where it is sold. Read once when she pastes it — see lib/link-preview.ts
  /// — and everything read is hers to correct.
  url        String?
  imageUrl   String?
  /// Text, not a number: "AED 249", "about ₦40,000", "whatever you like".
  /// A decimal column would force a currency and a precision onto something
  /// that is a note to a guest, not an amount anybody is charged.
  price      String?
  /// How many are wanted. Two of the same sleepsuit is a real answer.
  quantity   Int      @default(1)
  /// The handful of things that actually matter, said so plainly.
  mostNeeded Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  claims RegistryClaim[]

  @@index([registryId, position])
}

/// Somebody saying they are getting this.
///
/// A reservation, not a receipt. Nobody here knows whether the cot was
/// actually bought, and this row does not claim to: what it does is stop the
/// second grandmother buying the second cot, which is the entire practical
/// job a registry has.
///
/// No account, and there will never be one. The guest's browser keeps a long
/// random token, the same way an invitation reply does, which is how the same
/// person changes their mind rather than adding a second claim, and why one
/// guest cannot release another's.
model RegistryClaim {
  id        String       @id @default(cuid())
  itemId    String
  item      RegistryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  token     String
  /// Optional: somebody may give anonymously, and a mother writing thank-you
  /// notes would rather have a name than a blank — so it is asked for and
  /// never required.
  name      String?
  note      String?
  quantity  Int          @default(1)
  createdAt DateTime     @default(now())
  /// Ticked off by her when the thank-you has been said.
  thankedAt DateTime?

  @@unique([itemId, token])
  @@index([itemId])
}

/// Capturing the firsts.
model Milestone {
  id         String        @id @default(cuid())
  journeyId  String
  journey    Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  childId    String?
  child      Child?        @relation(fields: [childId], references: [id], onDelete: SetNull)
  kind       MilestoneKind
  title      String? // custom label, especially when kind is CUSTOM
  note       String?
  occurredAt DateTime
  photoUrls  String[]      @default([])
  createdAt  DateTime      @default(now())

  @@index([journeyId, occurredAt])
}

/// Gentle reminders — "check in on her today" / appointment reminders.
model Nudge {
  id         String    @id @default(cuid())
  journeyId  String
  journey    Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  dueAt      DateTime
  doneAt     DateTime?
  /// Stamped the morning this one is told, so it is told once and never again.
  /// Null on every row that existed before reminders worked at all; those are
  /// skipped by the date window rather than fired off in a batch.
  remindedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([journeyId, dueAt])
  @@index([dueAt])
}

/// A short word of encouragement or Scripture from one member to another —
/// the two-way connective tissue between the mother and her supporter.
model Encouragement {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  verseRef  String?
  createdAt DateTime @default(now())

  @@index([journeyId, createdAt])
}

/// One row per supporter per day: did they pray for her / reach out today?
/// Powers the partner's faithfulness streak.
model SupportDay {
  id         String   @id @default(cuid())
  journeyId  String
  journey    Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day        DateTime @db.Date
  prayed     Boolean  @default(false)
  reachedOut Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([journeyId, userId, day])
  @@index([journeyId, userId])
}

// ── Appointments ──────────────────────────────────────────────────────────
/// What kind of appointment it is. The kind decides how far ahead it is worth
/// reminding somebody — see lib/appointments.ts.
enum AppointmentKind {
  ANTENATAL // a routine midwife or doctor check
  SCAN // an ultrasound — dating, anomaly, growth
  TEST // bloods, glucose, swabs
  CONSULTANT // a specialist
  POSTNATAL // the mother's own check after the birth
  BABY_CHECK // the baby's check
  IMMUNISATION
  /// RETIRED. A class is a thing she chooses to go to, often with people she
  /// invites — a day of her own, not a room she is called into — so it lives
  /// in JourneyEventKind now, and nothing in the app will file one here again:
  /// it is gone from APPOINTMENT_KINDS, so it is offered by no form and
  /// accepted by no action. Every class already written down was moved by
  /// scripts/move-classes.mjs.
  ///
  /// The value stays in the type on purpose. Dropping a value from a Postgres
  /// enum needs `--accept-data-loss` on `prisma db push`, and that flag would
  /// sit in the build accepting every future destruction too — a much worse
  /// thing than one unused word in a type nobody reads. It also means a row
  /// written in the seconds between the move and the deploy still reads back
  /// correctly instead of erroring.
  CLASS
  OTHER
}

/// What kind of day somebody has written down. Not clinical — that is what
/// Appointment is for.
enum JourneyEventKind {
  CLASS // an antenatal or parenting class
  SHOWER // a baby shower
  GATHERING // other mothers, friends coming round, a meal
  CHURCH
  CELEBRATION
  OTHER
}

/// A day the household has written down that is not a clinic letter.
///
/// ── Why this is not just another AppointmentKind ─────────────────────────
/// An Appointment is a room you are called into: it carries `who` (the midwife
/// to ask for), `questions` (the things you mean to ask and forget), and an
/// `outcome` afterwards. None of that is true of a baby shower, and a shower
/// is not something the mother "attends" — it is something somebody hosts.
///
/// They sit on the same calendar because that is what a person wants to look
/// at. They are different rows because they are different things, and only
/// one of them is something you can invite people to.
model JourneyEvent {
  id               String           @id @default(cuid())
  journeyId        String
  journey          Journey          @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User             @relation("JourneyEventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  kind             JourneyEventKind @default(GATHERING)
  title            String
  at               DateTime
  /// "Saturday afternoon" is a real answer, and inventing 09:00 would become a
  /// wrong morning reminder later.
  hasTime          Boolean          @default(true)
  /// When it finishes, where anybody said. Optional for the same reason.
  endsAt           DateTime?
  where            String?
  note             String?
  cancelledAt      DateTime?
  /// Where this day came from, when somebody who already uses Oyun copied an
  /// invitation they were sent into their own diary. A plain id, not a
  /// relation: the other journey may delete its invitation, and that must not
  /// reach into this one's diary.
  fromInvitationId String?
  /// Set only when somebody deliberately makes this day shareable.
  invitation       Invitation?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([journeyId, at])
  @@index([at])
  @@index([journeyId, fromInvitationId])
}

/// A day in the diary, made shareable with people who are not in this app.
///
/// ── Why this exists at all, in an app built on a closed circle ───────────
/// Oyun has no public profiles and nothing a stranger can browse to, and that
/// does not change here. What this is, is ONE link to ONE day, which the
/// household hands to people it chose, the way it would hand round a paper
/// invitation — the other mothers from the antenatal class, the friends coming
/// to a shower. Nothing about the journey is reachable from it: not her
/// appointments, not her letters, not a name that was not typed onto the
/// invitation itself. And it ends when she ends it.
///
/// Nothing exists here until somebody deliberately makes it. A day with no
/// Invitation row is exactly as private as it was before this feature.
model Invitation {
  id                  String             @id @default(cuid())
  eventId             String             @unique
  event               JourneyEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// The unguessable half of the link. Long, and from a real random source —
  /// see lib/invitations-db.ts, and NOT lib/rand.ts, which says of itself that
  /// it is not security-bearing.
  slug                String             @unique
  /// How the invitation signs itself: "Amara and Chidi", "The antenatal group".
  /// Typed rather than taken from an account, so she chooses what a guest sees.
  hostName            String
  message             String?
  /// Whether a guest sees who else is coming. At a shower that is half the
  /// reason to come; at a quiet supper it is nobody's business.
  showGuestList       Boolean            @default(true)
  allowPlusOnes       Boolean            @default(true)
  /// A cap on heads, not on replies: somebody may always still answer no.
  capacity            Int?
  repliesBy           DateTime?
  /// Stopped taking replies. The invitation still reads.
  closedAt            DateTime?
  /// The link is dead. Kept rather than deleted, so the replies survive it.
  revokedAt           DateTime?
  /// Set when a "which day suits?" has been decided. Null and with options on
  /// it means the question is still open; no options at all means there was
  /// never a question, which is the ordinary invitation.
  settledAt           DateTime?
  /// Reminder bookkeeping, stamped the moment each is sent — the same shape
  /// Appointment already uses, rather than a separate ledger table. A journey
  /// event never repeats, so there is no occurrence to key on: one stamp per
  /// invitation is the whole truth. Moving the day clears them, or the stamp
  /// for the old day would swallow the reminder for the new one.
  remindedDayBeforeAt DateTime?
  remindedMorningAt   DateTime?
  /// The count sent to the household the evening before — separate, because it
  /// goes to different people and must not be suppressed by the guests' row.
  hostDigestAt        DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  replies             InvitationReply[]
  options             InvitationOption[]
}

/// One of the days being offered in a "which day suits?".
model InvitationOption {
  id           String           @id @default(cuid())
  invitationId String
  invitation   Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  at           DateTime
  hasTime      Boolean          @default(true)
  endsAt       DateTime?
  createdAt    DateTime         @default(now())
  votes        InvitationVote[]

  @@index([invitationId, at])
}

/// A guest ticking one day as one that works for them.
///
/// It hangs off their REPLY, not off a name or a session, so the token already
/// in their browser owns their ticks as well as their answer.
model InvitationVote {
  optionId String
  option   InvitationOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  replyId  String
  reply    InvitationReply  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@id([optionId, replyId])
  @@index([replyId])
}

/// One guest's answer. No account, and never one.
model InvitationReply {
  id           String           @id @default(cuid())
  invitationId String
  invitation   Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  /// The guest's own secret, kept in their browser. It is what lets somebody
  /// change their mind — real people tap twice, and without it the second tap
  /// makes a second guest — and what stops one guest editing another's reply.
  token        String           @unique
  name         String
  /// Optional, and the only contact detail this app will ever hold for
  /// somebody who is not in it. Used for this one day and nothing else.
  email        String?
  /// "YES" | "MAYBE" | "NO". A string rather than an enum so another answer
  /// could be added without a migration that rewrites the column.
  answer       String
  /// Including themselves. 1 means "just me".
  partySize    Int              @default(1)
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  votes        InvitationVote[]

  @@index([invitationId, createdAt])
}

/// A hospital or clinic appointment, and everything a tired person needs to
/// walk into the room prepared.
///
/// Deliberately household-only: a scan date is health information, and the
/// wider circle of friends and relatives has no business with it unless the
/// mother chooses to name it on the prayer wall herself.
model Appointment {
  id          String          @id @default(cuid())
  journeyId   String
  journey     Journey         @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  kind        AppointmentKind @default(ANTENATAL)
  /// An optional name of its own, when "Antenatal" is not enough.
  title       String?

  /// When it is. Stored as an instant; see `hasTime` for whether the clock
  /// part means anything.
  at      DateTime
  /// Hospital letters often say "Tuesday the 4th" with no hour at all, and
  /// inventing 09:00 would be a lie that later becomes a missed morning
  /// reminder. When this is false only the day is shown, and no morning-of
  /// reminder is sent.
  hasTime Boolean  @default(true)

  where     String?
  /// The midwife, doctor or clinic — so you know who to ask for on arrival.
  who       String?
  notes     String?
  /// The things you mean to ask and always forget once you are in the room.
  questions String?

  /// Afterwards.
  attendedAt  DateTime?
  outcome     String?
  cancelledAt DateTime?

  /// Reminder bookkeeping. Each stage is stamped the moment it is sent, so a
  /// reminder can never go twice however often the job runs — and a row that
  /// was created late simply skips the stages whose moment has passed.
  remindedWeekAt    DateTime?
  remindedDayAt     DateTime?
  remindedMorningAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId, at])
  @@index([at])
}
